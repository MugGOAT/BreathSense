import os
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Creating a matrix
K = np.array([[4, 4, 4, 4, 4],
 [3, 4, 5, 4, 3],
 [3, 5, 5, 5, 3],
 [3, 4, 5, 4, 3],
 [4, 4, 4, 4, 4]], dtype=np.uint8)
print(K, K.dtype, K.shape)

# Reading an image
image_path = r"F:\MIT-BIO\Medical Imaging\(3) Practical\Practical\Images\ChestXRD.pn
image = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
print(image, image.dtype, image.shape)

# Display images and histograms
plt.figure(figsize=(10, 8))
plt.subplot(2, 2, 1)
plt.imshow(K, cmap="gray", vmin=0, vmax=7)
plt.title('Matrix K')
plt.subplot(2, 2, 2)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.subplot(2, 2, 3)
plt.hist(K.ravel(), bins=8, range=[0, 7], color='blue', alpha=0.7)
plt.title('Histogram of Matrix K')
plt.subplot(2, 2, 4)
plt.hist(image.ravel(), bins=256, range=[0, 255], color='blue', alpha=0.7)
plt.title('Histogram of Original Image')
plt.tight_layout()
plt.show()

# Perform histogram equalization
G_K = cv2.equalizeHist(K)
G_image = cv2.equalizeHist(image)

# Display processed images and histograms
plt.figure(figsize=(10, 8))
plt.subplot(2, 2, 1)
plt.imshow(G_K, cmap="gray", vmin=0, vmax=255)
plt.title('Processed Matrix K (HE)')
plt.subplot(2, 2, 2)
plt.imshow(G_image, cmap='gray')
plt.title('Processed Image (HE)')
plt.subplot(2, 2, 3)
plt.hist(G_K.ravel(), bins=256, range=[0, 255], color='blue', alpha=0.7)
plt.title('Histogram of Processed Matrix K')
plt.subplot(2, 2, 4)
plt.hist(G_image.ravel(), bins=256, range=[0, 255], color='blue', alpha=0.7)
plt.title('Histogram of Processed Image')
plt.tight_layout()
plt.show()

# Load and process non-uniform illuminated image
os.chdir(r"F:\MIT-BIO\Medical Imaging\(3) Practical\Practical\Images")
NUIll = cv2.imread('NUIimage.png', cv2.IMREAD_GRAYSCALE)
print(NUIll.shape)

# Global HE
G_NUIll = cv2.equalizeHist(NUIll)

# Implementing CLAHE
clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
clahe_NUIll = clahe.apply(NUIll)

# Display images
plt.figure(figsize=(12, 4))
plt.subplot(1, 3, 1)
plt.imshow(NUIll, cmap="gray", vmin=0, vmax=255)
plt.title('Original Image')
plt.subplot(1, 3, 2)
plt.imshow(G_NUIll, cmap="gray", vmin=0, vmax=255)
plt.title('Global HE Image')
plt.subplot(1, 3, 3)
plt.imshow(clahe_NUIll, cmap="gray", vmin=0, vmax=255)
plt.title('CLAHE Image')
plt.tight_layout()
plt.show()
