import os
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Reading an image
os.chdir(r"F:\MIT-BIO\(1) Medical Imaging\(3) Practical\Practical\Images")
image = cv2.imread('ChestXRD.png', 0)
row, col = image.shape

# Image rotation
R = cv2.getRotationMatrix2D((0, 0), 50, 1)
rotated_image = cv2.warpAffine(image, R, (image.shape[1], image.shape[0]))

# Display image
plt.subplot(1, 2, 1)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.subplot(1, 2, 2)
plt.imshow(rotated_image, cmap="gray")
plt.title('Rotated Image')
plt.show()

# Image scaling
scaled_image = cv2.resize(image, (2 * row, 3 * col))

# Display image
plt.subplot(1, 2, 1)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.subplot(1, 2, 2)
plt.imshow(scaled_image, cmap="gray")
plt.title('Scaled Image')
plt.show()

# Image translation
T = np.float32([[1, 0, 150], [0, 1, 50]])
shifted_image = cv2.warpAffine(image, T, (image.shape[1], image.shape[0]))

# Display image
plt.subplot(1, 2, 1)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.subplot(1, 2, 2)
plt.imshow(shifted_image, cmap="gray")
plt.title('Shifted Image')
plt.show()

# Image crop
crop = image[50:180, 100:300]

# Display image
plt.subplot(1, 2, 1)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.subplot(1, 2, 2)
plt.imshow(crop, cmap="gray")
plt.title('Crop Image')
plt.show()
