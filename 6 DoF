clc;
clear;
close all;

%% Link lengths
L1 = 5;
L2 = 6;
L3 = 4;
L4 = 3;
L5 = 2;
L6 = 2;

%% User input
theta1 = input('Enter theta1 (in degrees): ');
theta2 = input('Enter theta2 (in degrees): ');
theta3 = input('Enter theta3 (in degrees): ');
theta4 = input('Enter theta4 (in degrees): ');
theta5 = input('Enter theta5 (in degrees): ');
theta6 = input('Enter theta6 (in degrees): ');

%% Convert degrees to radians
t1 = deg2rad(theta1);
t2 = deg2rad(theta2);
t3 = deg2rad(theta3);
t4 = deg2rad(theta4);
t5 = deg2rad(theta5);
t6 = deg2rad(theta6);

%% Base position
x0 = 0;
y0 = 0;

%% Joint 1
x1 = L1*cos(t1);
y1 = L1*sin(t1);

%% Joint 2
x2 = x1 + L2*cos(t1+t2);
y2 = y1 + L2*sin(t1+t2);

%% Joint 3
x3 = x2 + L3*cos(t1+t2+t3);
y3 = y2 + L3*sin(t1+t2+t3);

%% Joint 4
x4 = x3 + L4*cos(t1+t2+t3+t4);
y4 = y3 + L4*sin(t1+t2+t3+t4);

%% Joint 5
x5 = x4 + L5*cos(t1+t2+t3+t4+t5);
y5 = y4 + L5*sin(t1+t2+t3+t4+t5);

%% End Effector
x6 = x5 + L6*cos(t1+t2+t3+t4+t5+t6);
y6 = y5 + L6*sin(t1+t2+t3+t4+t5+t6);

%% Display End Effector Position
fprintf('\nEnd Effector Position:\n');
fprintf('X = %.2f\n', x6);
fprintf('Y = %.2f\n', y6);

%% Plot Robot
figure;

plot([x0 x1 x2 x3 x4 x5 x6],
     [y0 y1 y2 y3 y4 y5 y6], '-o',
     'LineWidth', 4,
     'MarkerSize', 8,
     'Color', 'r',              

grid on;
axis equal;

xlim([-25 25]);
ylim([-25 25]);

xlabel('X');
ylabel('Y');

title(sprintf(['6 DOF ROBOT: \\theta_1 = %.1f°, \\theta_2 = %.1f°, ' ...
               '\\theta_3 = %.1f°, \\theta_4 = %.1f°, ' ...
               '\\theta_5 = %.1f°, \\theta_6 = %.1f°'], ...
               theta1, theta2, theta3, theta4, theta5, theta6));

%% Label joints
text(x0, y0, ' Base');

text(x1, y1, ' Joint 1');
text(x2, y2, ' Joint 2');
text(x3, y3, ' Joint 3');
text(x4, y4, ' Joint 4');
text(x5, y5, ' Joint 5');
text(x6, y6, ' End Effector');
